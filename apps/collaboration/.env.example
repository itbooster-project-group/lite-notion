NODE_ENV=development
PORT=3002
# Origin шлюза: за ним и frontend, и WebSocket.
COLLABORATION_ALLOWED_ORIGIN=http://localhost:8080
# Доступ к данным только через API: собственного подключения к базе нет.
API_BASE_URL=http://localhost:3001
API_TIMEOUT_MS=2000
INTERNAL_SERVICE_TOKEN=local-development-only-change-me-before-deploy
REDIS_HOST=localhost
REDIS_PORT=6379
WEBSOCKET_MAX_PAYLOAD_BYTES=1048576
