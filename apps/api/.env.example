NODE_ENV=development
PORT=3001
# Origin шлюза: за ним frontend и API на одном адресе.
CORS_ORIGIN=http://localhost:8080

# DATABASE
POSTGRES_USER=lite_notion
POSTGRES_DB=lite_notion
POSTGRES_PASSWORD=lite_notion
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
DATABASE_CONNECTION_TIMEOUT_MS=5000

# AUTH
# Local development placeholder only. Generate a unique value per environment,
# for example with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=local-development-only-change-me-before-deploy
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
BCRYPT_ROUNDS=12

# INTERNAL SERVICE CALLS
# Shared secret presented by collaboration runtime on internal document routes.
# Local development placeholder only; generate a unique value per environment.
INTERNAL_SERVICE_TOKEN=local-development-only-change-me-before-deploy
COLLABORATION_BASE_URL=http://localhost:3002
COLLABORATION_TIMEOUT_MS=5000

# Optional frontend cache invalidation. Configure URL and token together.
# PUBLICATION_REVALIDATION_URL=http://localhost:8080/api/internal/revalidate
# PUBLICATION_REVALIDATION_TOKEN=local-development-only-change-me
# PUBLICATION_REVALIDATION_TIMEOUT_MS=5000

# ASSETS
# Local development can run without cloud storage; upload requests then return unavailable.
# Production uses a private S3-compatible bucket (Selectel initially).
ASSETS_S3_ENDPOINT=
ASSETS_S3_REGION=
ASSETS_S3_BUCKET=
ASSETS_S3_ACCESS_KEY_ID=
ASSETS_S3_SECRET_ACCESS_KEY=
ASSETS_S3_FORCE_PATH_STYLE=false
ASSETS_S3_REQUEST_TIMEOUT_MS=15000
ASSETS_UPLOAD_TIMEOUT_MS=120000
ASSETS_READ_URL_TTL_SECONDS=60
ASSETS_MAX_UPLOAD_BYTES=10485760
ASSETS_MAX_CONCURRENT_UPLOADS=4
ASSETS_PENDING_TTL_HOURS=24
ASSETS_ORPHAN_GRACE_HOURS=24
ASSETS_GC_INTERVAL_SECONDS=60
ASSETS_GC_BATCH_SIZE=50
ASSETS_PROJECTION_STALE_WARNING_SECONDS=300
ASSETS_GC_ENABLED=false
