  "info": {
    "title": "Lite Notion API",
    "description": "HTTP API for Lite Notion",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token issued by /auth/login or /auth/register",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com",
            "format": "email"
          },
          "name": {
            "type": "string",
            "example": "Ada",
            "maxLength": 64,
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "bcrypt truncates its input at 72 UTF-8 bytes, so the limit is measured in bytes, not characters: 40 Cyrillic characters or 18 emoji already exceed it.",
            "example": "correct horse battery staple",
            "maxLength": 72,
            "minLength": 8
          }
        },
        "required": ["email", "name", "password"]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "4c8f1b1a-0f6d-4a5e-9f6d-0f6d4a5e9f6d",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "ada@example.com",
            "format": "email"
          },
          "name": {
            "type": "string",
            "example": "Ada"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-08-21T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": ["id", "email", "name", "createdAt"]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived bearer token. The refresh token is sent as an HttpOnly cookie.",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds",
            "example": 900
          },
          "user": {
            "$ref": "#/components/schemas/UserProfileDto"
          }
        },
        "required": ["accessToken", "expiresIn", "user"]
      },
      "HttpErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Service Unavailable"
          },
          "message": {
            "type": "string",
            "example": "Database is unavailable"
          },
          "path": {
            "type": "string",
            "example": "/api/v1/health"
          },
          "statusCode": {
            "type": "number",
            "example": 503
          },
          "timestamp": {
            "type": "string",
            "example": "2026-08-18T12:00:00.000Z",
            "format": "date-time"
          }
        },
        "required": ["error", "message", "path", "statusCode", "timestamp"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "bcrypt truncates its input at 72 UTF-8 bytes, so the limit is measured in bytes, not characters: 40 Cyrillic characters or 18 emoji already exceed it.",
            "example": "correct horse battery staple"
          }
        },
        "required": ["email", "password"]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived bearer token. The refresh token is sent as an HttpOnly cookie.",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds",
            "example": 900
          }
        },
        "required": ["accessToken", "expiresIn"]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"],
            "example": "ok"
          },
          "database": {
            "type": "string",
            "enum": ["up"],
            "example": "up"
          }
        },
        "required": ["status", "database"]
      },
      "CreatePageDto": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "example": "4c8f1b1a-0f6d-4a5e-9f6d-0f6d4a5e9f6d",
            "format": "uuid"
          },
          "parentPageId": {
            "type": "string",
            "description": "Parent page. Omit or send null to create a root page.",
            "format": "uuid",
            "nullable": true
          },
          "title": {
            "type": "string",
            "default": "",
            "maxLength": 255
          }
        },
        "required": ["projectId"]
      },
      "PageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "4c8f1b1a-0f6d-4a5e-9f6d-0f6d4a5e9f6d",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string",
            "example": "9f6d4a5e-0f6d-4a5e-9f6d-0f6d4a5e9f6d",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "example": "1b1a4c8f-0f6d-4a5e-9f6d-0f6d4a5e9f6d",
            "format": "uuid"
          },
          "parentPageId": {
            "type": "string",
            "format": "uuid",
