generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(uuid()) @db.Uuid
  email            String             @unique
  name             String
  passwordHash     String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sessions         Session[]
  projects         Project[]
  ownedPages       Page[]             @relation("PageOwner")
  createdPages     Page[]             @relation("PageCreatedBy")
  createdSnapshots DocumentSnapshot[] @relation("DocumentSnapshotCreatedBy")
  uploadedAssets   Asset[]            @relation("AssetUploader")
  profile          UserProfile?

  pagePermissions        PagePermission[] @relation("PagePermissionUser")
  grantedPagePermissions PagePermission[] @relation("PagePermissionGrantedBy")
}

/// Одна строка на выданную пару токенов. Refresh-токен хранится только как SHA-256 хеш.
/// familyId связывает цепочку ротаций одного входа; инвариант — в цепочке не более
/// одной строки с revokedAt = null. Подробности в openspec design.md, раздел 3.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Источник удаления страницы: кто именно инициировал пометку. Отличает корень
/// корзины от каскадно помеченных потомков и задаёт границы восстановления.
/// SELF восстанавливается адресно и не воскресает вместе с предком; PARENT_PAGE
/// снимается восстановлением предка-страницы; PROJECT — восстановлением проекта.
/// Подробности в openspec design.md, раздел 2.
enum PageDeletionOrigin {
  SELF
  PARENT_PAGE
  PROJECT
}

/// Где останавливается наследование доступа. INHERIT — при отсутствии прямого
/// разрешения доступ ищется у родителя; RESTRICTED — подъём прекращается здесь.
/// Границу видит только наследование: владельца и прямое разрешение на самой
/// странице режим не отменяет. Подробности в openspec design.md.
enum PageAccessMode {
  INHERIT
  RESTRICTED
}

/// Роли прямого разрешения. OWNER здесь нет намеренно: владение хранится в
/// Page.ownerId, и строкой разрешения не выражается.
enum PagePermissionRole {
  VIEWER
  EDITOR
}

enum SnapshotReason {
  automatic
  manual
  publication
  restore
}

enum AssetStatus {
  pending
  ready
  failed
  deleted
}

enum PagePublicationStatus {
  draft
  published
  unpublished
}

/// Контейнер верхнего уровня для дерева страниц. Пара (id, ownerId) — составной
/// ключ-кандидат: он существует только затем, чтобы на него мог сослаться composite
/// FK со стороны Page и база сама держала «проект страницы принадлежит её владельцу».
model Project {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @db.Uuid
  name      String    @db.VarChar(255)
  deletedAt DateTime?

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pages Page[]

  @@unique([id, ownerId])
  @@index([ownerId])
  @@index([ownerId, deletedAt])
  @@index([deletedAt])
}

// Узел дерева страниц. Дерево целиком принадлежит одному владельцу и лежит в одном
// проекте: и то, и другое держит тройной composite FK (parentPageId, ownerId,
// projectId) → Page(id, ownerId, projectId), а не проверка в коде. parentPageId
// nullable, и MATCH SIMPLE отключает проверку для root-страниц — это и нужно.
// Порядок братьев — fractional rank в position, подробности в openspec design.md.
//
// deletedAt и deletedOrigin — пара: оба null либо оба не null. Согласованность держит
// CHECK-constraint в миграции 20260831..._add_page_tree_soft_delete, а не код: Prisma
// такое ограничение не выражает. Мягкое удаление не трогает parentPageId и position —
// они нужны восстановлению, поэтому нарисованная в корзине вложенность и физическая
// расходятся, и корзина собирается по deletedOrigin, а не по parentPageId.
model Page {
  id            String              @id @default(uuid()) @db.Uuid
  ownerId       String              @db.Uuid
  projectId     String              @db.Uuid
  parentPageId  String?             @db.Uuid
  createdById   String              @db.Uuid
  title         String              @db.VarChar(255)
  position      String              @db.VarChar(255)
  accessMode    PageAccessMode      @default(INHERIT)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  deletedOrigin PageDeletionOrigin?

  owner            User                 @relation("PageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy        User                 @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  project          Project              @relation(fields: [projectId, ownerId], references: [id, ownerId], onDelete: Cascade)
  parent           Page?                @relation("PageTree", fields: [parentPageId, ownerId, projectId], references: [id, ownerId, projectId], onDelete: Cascade, onUpdate: NoAction)
  children         Page[]               @relation("PageTree")
  document         PageDocument?
  searchProjection PageSearchDocument?
  snapshots        DocumentSnapshot[]
  publication      PagePublication?
  permissions      PagePermission[]
  coverAssetId     String?              @db.Uuid
  coverAsset       Asset?               @relation("PageCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  assetGrants      PageAssetGrant[]
  assets           PageAsset[]
  assetProjection  PageAssetProjection?

  @@unique([id, ownerId, projectId])
  @@index([ownerId, parentPageId, position])
  @@index([ownerId, deletedAt])
  // Очистка по сроку хранения идёт без владельца: WHERE "deletedAt" < cutoff.
  @@index([deletedAt])
  @@index([coverAssetId])
}

/// Прямое разрешение пользователя на конкретную страницу. Составной PK держит
/// единственность пары и обслуживает чтение разрешений одной страницы; индекс
/// (userId, pageId) обслуживает обратное направление — подъём по цепочке и выдачу
/// доступных страниц, оба ищут по пользователю.
///
/// Запрет выдавать разрешение владельцу страницы остаётся прикладным: CHECK не
/// может сослаться на Page.ownerId из другой таблицы, а триггер ради одного
/// правила не окупается. Подробности в openspec design.md.
model PagePermission {
  pageId      String             @db.Uuid
  userId      String             @db.Uuid
  role        PagePermissionRole
  grantedById String             @db.Uuid
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  page      Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User @relation("PagePermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("PagePermissionGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([pageId, userId])
  @@index([userId, pageId])
  @@index([grantedById])
}

/// Содержимое страницы. Строка создаётся вместе со страницей пустой и удаляется
/// каскадом вместе с ней — отдельных операций создания и удаления нет.
/// yjsState непрозрачен для API: сервер хранит и отдаёт байты, не разбирая их.
/// storageRevision инкрементируется при каждой записи, но наружу не выходит:
/// версионирования и optimistic concurrency в текущем контракте нет.
model PageDocument {
  pageId              String   @id @db.Uuid
  tiptapSchemaVersion Int
  yjsState            Bytes
  storageRevision     BigInt   @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Asset {
  id           String      @id @default(uuid()) @db.Uuid
  uploadedById String      @db.Uuid
  status       AssetStatus @default(pending)
  storageKey   String      @unique
  originalName String      @db.VarChar(255)
  mimeType     String?
  checksum     String?     @db.VarChar(64)
  sizeBytes    BigInt?
  width        Int?
  height       Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  uploadedBy         User                @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  grants             PageAssetGrant[]
  pageAssets         PageAsset[]
  pageCovers         Page[]              @relation("PageCover")
  snapshotReferences SnapshotAsset[]
  publicationCovers  DocumentRendering[] @relation("PublicationRenderingCover")
  avatars            UserProfile[]       @relation("ProfileAvatar")

  @@index([uploadedById, deletedAt])
  @@index([status, createdAt])
}

model PageAssetGrant {
  pageId    String   @db.Uuid
  assetId   String   @db.Uuid
  createdAt DateTime @default(now())

  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  asset       Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  occurrences PageAsset[]

  @@id([pageId, assetId])
  @@index([assetId])
}

model PageAsset {
  pageId    String   @db.Uuid
  assetId   String   @db.Uuid
  nodeId    String   @db.VarChar(255)
  createdAt DateTime @default(now())

  page  Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  grant PageAssetGrant @relation(fields: [pageId, assetId], references: [pageId, assetId], onDelete: Cascade)
  asset Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([pageId, assetId, nodeId])
  @@index([assetId])
}

model PageAssetProjection {
  pageId                   String    @id @db.Uuid
  sourceStorageRevision    BigInt?
  attemptedStorageRevision BigInt?
  attemptCount             Int       @default(0)
  retryAfter               DateTime?
  lastErrorCode            String?
  updatedAt                DateTime  @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([sourceStorageRevision])
  @@index([retryAfter])
}

/// Восстанавливаемая FTS projection persisted Y.Doc; sourceStorageRevision —
/// watermark, а authoritative текст остаётся в PageDocument.yjsState.
model PageSearchDocument {
  pageId                   String                  @id @db.Uuid
  plainText                String                  @db.Text
  searchVector             Unsupported("tsvector")
  sourceStorageRevision    BigInt?
  attemptedStorageRevision BigInt?
  attemptCount             Int                     @default(0)
  retryAfter               DateTime?
  lastErrorCode            String?                 @db.VarChar(100)
  updatedAt                DateTime                @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([sourceStorageRevision])
  @@index([retryAfter])
}

model UserProfile {
  userId        String  @id @db.Uuid
  avatarAssetId String? @db.Uuid

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarAsset Asset? @relation("ProfileAvatar", fields: [avatarAssetId], references: [id], onDelete: Restrict)

  @@index([avatarAssetId])
}

model DocumentSnapshot {
  id                    String         @id @default(uuid()) @db.Uuid
  pageId                String         @db.Uuid
  createdById           String?        @db.Uuid
  revision              BigInt
  sourceStorageRevision BigInt
  tiptapSchemaVersion   Int
  yjsState              Bytes
  reason                SnapshotReason
  createdAt             DateTime       @default(now())

  page        Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("DocumentSnapshotCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  rendering   DocumentRendering?
  assets      SnapshotAsset[]
  publication PagePublication?

  @@unique([pageId, revision])
  @@unique([id, pageId])
  @@index([pageId, revision(sort: Desc)])
  @@index([pageId, sourceStorageRevision(sort: Desc)])
  @@index([createdById])
}

/// Immutable read-optimized projection of a snapshot. It never replaces Yjs as source of truth.
model DocumentRendering {
  snapshotId          String   @id @db.Uuid
  tiptapSchemaVersion Int
  contentJson         Json
  pageTitle           String   @db.VarChar(255)
  coverAssetId        String?  @db.Uuid
  generatedAt         DateTime @default(now())

  snapshot   DocumentSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  coverAsset Asset?           @relation("PublicationRenderingCover", fields: [coverAssetId], references: [id], onDelete: Restrict)

  @@index([coverAssetId])
}

/// Immutable references extracted from the same captured Yjs state as the snapshot.
model SnapshotAsset {
  snapshotId String   @db.Uuid
  assetId    String   @db.Uuid
  nodeId     String   @db.VarChar(255)
  createdAt  DateTime @default(now())

  snapshot DocumentSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  asset    Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([snapshotId, assetId, nodeId])
  @@index([assetId])
}

/// Current publication pointer and mutable publication metadata for a page.
model PagePublication {
  id             String                @id @default(uuid()) @db.Uuid
  pageId         String                @unique @db.Uuid
  snapshotId     String?               @db.Uuid
  slug           String                @unique @db.VarChar(100)
  status         PagePublicationStatus @default(draft)
  seoTitle       String?               @db.VarChar(255)
  seoDescription String?               @db.Text
  publishedAt    DateTime?
  updatedAt      DateTime              @updatedAt

  page     Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot DocumentSnapshot? @relation(fields: [snapshotId, pageId], references: [id, pageId], onDelete: Cascade)

  @@unique([snapshotId, pageId])
  @@index([status, snapshotId])
}

/// Durable post-commit route invalidation. Deliberately has no page FK so hard purge
/// cannot discard pending invalidations.
model PublicationRevalidation {
  id            String    @id @default(uuid()) @db.Uuid
  paths         String[]  @db.Text
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  leaseToken    String?   @db.Uuid
  leaseUntil    DateTime?
  deliveredAt   DateTime?
  lastErrorCode String?   @db.VarChar(100)
  createdAt     DateTime  @default(now())

  @@index([deliveredAt, nextAttemptAt, leaseUntil])
}
