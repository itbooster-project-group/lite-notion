generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  projects     Project[]
  ownedPages   Page[]    @relation("PageOwner")
  createdPages Page[]    @relation("PageCreatedBy")
}

/// Одна строка на выданную пару токенов. Refresh-токен хранится только как SHA-256 хеш.
/// familyId связывает цепочку ротаций одного входа; инвариант — в цепочке не более
/// одной строки с revokedAt = null. Подробности в openspec design.md, раздел 3.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Контейнер верхнего уровня для дерева страниц. Пара (id, ownerId) — составной
/// ключ-кандидат: он существует только затем, чтобы на него мог сослаться composite
/// FK со стороны Page и база сама держала «проект страницы принадлежит её владельцу».
model Project {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  name    String @db.VarChar(255)

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pages Page[]

  @@unique([id, ownerId])
  @@index([ownerId])
}

/// Узел дерева страниц. Дерево целиком принадлежит одному владельцу и лежит в одном
/// проекте: и то, и другое держит тройной composite FK (parentPageId, ownerId,
/// projectId) → Page(id, ownerId, projectId), а не проверка в коде. parentPageId
/// nullable, и MATCH SIMPLE отключает проверку для root-страниц — это и нужно.
/// Порядок братьев — fractional rank в position, подробности в openspec design.md.
model Page {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String    @db.Uuid
  projectId    String    @db.Uuid
  parentPageId String?   @db.Uuid
  createdById  String    @db.Uuid
  title        String    @db.VarChar(255)
  position     String    @db.VarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  owner     User          @relation("PageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy User          @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  project   Project       @relation(fields: [projectId, ownerId], references: [id, ownerId], onDelete: Cascade)
  parent    Page?         @relation("PageTree", fields: [parentPageId, ownerId, projectId], references: [id, ownerId, projectId], onDelete: Cascade, onUpdate: NoAction)
  children  Page[]        @relation("PageTree")
  document  PageDocument?

  @@unique([id, ownerId, projectId])
  @@index([ownerId, parentPageId, position])
  @@index([ownerId, deletedAt])
}

/// Содержимое страницы. Строка создаётся вместе со страницей пустой и удаляется
/// каскадом вместе с ней — отдельных операций создания и удаления нет.
/// yjsState непрозрачен для API: сервер хранит и отдаёт байты, не разбирая их.
/// storageRevision инкрементируется при каждой записи, но наружу не выходит:
/// версионирования и optimistic concurrency в текущем контракте нет.
model PageDocument {
  pageId              String   @id @db.Uuid
  tiptapSchemaVersion Int
  yjsState            Bytes
  storageRevision     BigInt   @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}
