# Local-only Playwright collaboration E2E configuration.
# Copy to .env.e2e and replace every placeholder before running the tests.

# Existing page ID from the URL: http://localhost:8080/pages/<PAGE_ID>
PLAYWRIGHT_PAGE_ID=<page-id>

# Existing test accounts. The test logs in through the application UI.
PLAYWRIGHT_USER_A_EMAIL=<user-a-email>
PLAYWRIGHT_USER_A_PASSWORD=<user-a-password>
PLAYWRIGHT_USER_B_EMAIL=<user-b-email>
PLAYWRIGHT_USER_B_PASSWORD=<user-b-password>

# Required for presence and multi-user collaboration scenarios.
PLAYWRIGHT_USER_A_ID=<user-a-id>
PLAYWRIGHT_USER_A_NAME=<user-a-name>
PLAYWRIGHT_USER_B_ID=<user-b-id>
PLAYWRIGHT_USER_B_NAME=<user-b-name>

# Required only for the page-switching scenario.
# PLAYWRIGHT_SECOND_PAGE_ID=<second-page-id>

# Optional; defaults to the gateway used by the Playwright config.
# PLAYWRIGHT_BASE_URL=http://localhost:8080
