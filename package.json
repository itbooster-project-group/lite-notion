{
  "name": "lite-notion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "pnpm --filter @lite-notion/api openapi:generate && pnpm --filter @lite-notion/web api:generate && pnpm exec biome check --write --unsafe apps/api/openapi.json apps/web/src/shared/api/generated",
    "api:check": "pnpm api:generate && git diff --exit-code -- apps/api/openapi.json apps/web/src/shared/api/generated",
    "db:up": "docker compose -f apps/api/docker-compose.yaml up -d --wait postgres",
    "db:down": "docker compose -f apps/api/docker-compose.yaml down",
    "dev": "pnpm db:up && pnpm --parallel --filter \"./apps/*\" run dev",
    "dev:api": "pnpm db:up && pnpm --filter @lite-notion/api dev",
    "dev:web": "pnpm --filter @lite-notion/web dev",
    "build": "pnpm --recursive run build",
    "web:build": "pnpm --filter @lite-notion/web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive run typecheck",
    "web:typecheck": "pnpm --filter @lite-notion/web typecheck",
    "test": "pnpm --recursive run test",
    "web:test": "pnpm --filter @lite-notion/web test",
    "prepare": "husky",
    "steiger": "pnpm steiger:web",
    "steiger:web": "CHOKIDAR_USEPOLLING=1 steiger ./apps/web/src",
    "steiger:watch": "pnpm steiger:web:watch",
    "steiger:web:watch": "steiger --watch ./apps/web/src"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome format --write --no-errors-on-unmatched",
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11.21.0 <12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "steiger": "^0.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  }
}
