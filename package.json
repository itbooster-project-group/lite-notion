{
  "name": "lite-notion",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --recursive run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11.21.0 <12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0"
  }
}
