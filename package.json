{
  "name": "lite-notion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --recursive run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "steiger": "pnpm steiger:web",
    "steiger:web": "steiger ./apps/web/src",
    "steiger:watch": "pnpm steiger:web:watch",
    "steiger:web:watch": "steiger --watch ./apps/web/src"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11.21.0 <12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "steiger": "^0.6.0"
  }
}
